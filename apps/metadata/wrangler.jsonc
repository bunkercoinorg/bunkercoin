{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bunkercoin-metadata",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [
    {
      "binding": "METADATA",
      "bucket_name": "bunkercoin-metadata"
    }
  ],
  "vars": {
    "NODE_API_URL": "https://api.bunkercoin.com",
    "ALLOWED_ORIGINS": "https://wallet.bunkercoin.com,https://explorer.bunkercoin.com",
    "ALLOW_LOCALHOST": "false"
  },
  "ratelimits": [
    {
      "name": "UPLOAD_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "PROMOTE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "metadata.bunkercoin.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
