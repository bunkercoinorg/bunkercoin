// Static-assets deploy: the wallet is a pure client-side export (no server,
// no OpenNext) — keys and crypto live in the browser, RPC goes straight to
// rpc.bunkercoin.com.
{
  "name": "bunkercoin-wallet",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "single-page-application"
  }
}
